{
  "name": "fc-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "check": "node scripts/check-content.mjs",
    "build": "node scripts/check-content.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "qr": "node scripts/make-qr.mjs",
    "test": "vitest run",
    "verify:fast": "node scripts/check-content.mjs && tsc --noEmit && vitest run",
    "verify": "npm run verify:fast && next build",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "fuse.js": "^7.5.0",
    "next": "^16.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
