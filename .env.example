# 복사해서 .env.local 로 만들고 값을 채우세요. (.env.local 은 절대 GitHub에 올리지 마세요)
NEXT_PUBLIC_SITE_URL=https://example.kr
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FC_OWNER_ID=
# 구글 시트 자동 입력 + 알림 메일 (선택). 비워 두면 시트 연동을 건너뜁니다.
# SHEET_WEBHOOK_URL: Apps Script 웹 앱 주소 (https://script.google.com/ 로 시작)
# SHEET_WEBHOOK_SECRET: 16자 이상 비밀 키 (Apps Script 의 스크립트 속성 LEAD_SECRET 과 같은 값)
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
# 1 로 설정하면 심의번호/프로필 미확정 시 빌드가 실패합니다 (운영 배포 시 권장)
REQUIRE_REVIEW=0
# 관리자 화면(/admin) — 둘 다 입력해야 켜집니다. 비밀번호 12자 이상, 세션 비밀값 32자 이상(길고 무작위로)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# 선택: 관리자 로그인 화면을 여는 비밀 주소 꼬리표(8자 이상). 비우면 ADMIN_SESSION_SECRET 앞 12자를 씁니다. 접속: /admin?k=이 값
ADMIN_ENTRY_KEY=
# Supabase 일시중지 방지 정기 호출(Vercel Cron) 인증값 — 16자 이상 무작위. Vercel 환경변수에도 같은 이름으로 등록
CRON_SECRET=
