# 복사해서 .env.local 로 만들고 값을 채우세요. (.env.local 은 절대 GitHub에 올리지 마세요)
NEXT_PUBLIC_SITE_URL=https://example.kr
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FC_OWNER_ID=
# 구글 시트 자동 입력 + 알림 메일 (선택). 비워 두면 시트 연동을 건너뜁니다.
# SHEET_WEBHOOK_URL: Apps Script 웹 앱 주소 (https://script.google.com/ 로 시작)
# SHEET_WEBHOOK_SECRET: 16자 이상 비밀 키 (Apps Script 의 스크립트 속성 LEAD_SECRET 과 같은 값)
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
# 1 로 설정하면 심의번호/프로필 미확정 시 빌드가 실패합니다 (운영 배포 시 권장)
REQUIRE_REVIEW=0
